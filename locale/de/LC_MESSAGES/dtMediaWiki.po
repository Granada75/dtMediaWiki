msgid "Error: "
msgstr "Fehler: "

#: dtMediaWiki.lua:878
msgid "register_storage_store: exporting the following image:"
msgstr "register_storage_store: exportiere folgendes Bild:"

#: dtMediaWiki.lua:882
msgid "BUG: invalid tag 0 for image "
msgstr "FEHLER: ungültiger Tag 0 für Bild "

#: dtMediaWiki.lua:900 dtMediaWiki.lua:916
msgid "exported "
msgstr "hochgeladen: "

#: dtMediaWiki.lua:902
msgid "Failed to export "
msgstr "Export fehlgeschlagen: "

#: dtMediaWiki.lua:917
msgid " images to Wikimedia Commons"
msgstr " Bilder zu Wikimedia Commons hochgeladen"

#: dtMediaWiki.lua:951
msgid "BUG: dt.register_storage.initialize sent a number instead of dt_lua_image_t in images table: "
msgstr "FEHLER: dt.register_storage.initialize hat in der Bildertabelle eine Zahl statt dt_lua_image_t übergeben: "

#: dtMediaWiki.lua:957
msgid "has no rights"
msgstr "hat keine Rechteangabe"

#: dtMediaWiki.lua:974
msgid "is missing a title, which is required by the filename pattern"
msgstr "hat keinen Titel, der vom Dateinamensmuster benötigt wird"

#: dtMediaWiki.lua:990
msgid "is missing a description, which is required by the filename pattern"
msgstr "hat keine Beschreibung, die vom Dateinamensmuster benötigt wird"

#: dtMediaWiki.lua:1019
msgid "is missing both title and description, resulting in an empty 'Information|description' field on the Commons page (and the 'Allow empty Information|description...' preference is off)"
msgstr "hat weder Titel noch Beschreibung, wodurch auf der Commons-Seite ein leeres Feld „Information|description“ entstehen würde (und die Einstellung „Leeres Information|description erlauben …“ ist deaktiviert)"

#: dtMediaWiki.lua:1044
msgid ", won't be exported to Wikimedia Commons"
msgstr ", wird nicht zu Wikimedia Commons hochgeladen"

#: dtMediaWiki.lua:1057
msgid "Write Commons preview"
msgstr "Commons-Vorschau schreiben"

#: dtMediaWiki.lua:1111
msgid "Naming pattern:"
msgstr "Namensmuster:"

#: dtMediaWiki.lua:1124 lib/placeholders.lua:1052
msgid "Categories"
msgstr "Kategorien"

#: dtMediaWiki.lua:1132 lib/placeholders.lua:1041
msgid "Templates"
msgstr "Vorlagen"

#: dtMediaWiki.lua:1143
msgid "Comment:"
msgstr "Kommentar:"

#: dtMediaWiki.lua:1153
msgid "Language code:"
msgstr "Sprachcode:"

#: dtMediaWiki.lua:1155
