msgstr "dtMediaWiki.get_alt_images: gefunden "

#: dtMediaWiki.lua:742 dtMediaWiki.lua:744
msgid "Uploaded with dtMediaWiki "
msgstr "Hochgeladen mit dtMediaWiki "

